# ==============================================================================
# YAYASAN MUHAMMAD TAHIR GARUT - ENVIRONMENT VARIABLES
# Salin file ini menjadi .env.local dan lengkapi nilai konfigurasi Anda.
# JANGAN PERNAH mengunggah .env.local ke GitHub atau mengekspos key rahasia.
# ==============================================================================

# 1. URL Publik Aplikasi (untuk metadata SEO, Open Graph, dan redirect auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Konfigurasi Supabase (Wajib untuk database, auth, dan storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# RAHASIA SERVER-ONLY: Jangan pernah diawali NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Konfigurasi Google Sheets API (Sinkronisasi Rekap PPDB)
# ID Spreadsheet diambil dari URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Email Service Account dari Google Cloud Console (contoh: ppdb-sync@project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private Key Service Account (pertahankan \n sebagai newline yang di-escape)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Opsional: Webhook Google Apps Script (alternatif jika tidak memakai Service Account)
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# 5. Keamanan & Rate Limiting
# Secret tambahan untuk validasi internal / cron retry
INTERNAL_CRON_SECRET=change-this-to-a-strong-random-string
